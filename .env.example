# Copy to .env (never commit the real .env). All secrets live here, never in code.

# --- auth (Phase: auth) ---
TEAM_PASSWORD=change-this-shared-password
SECRET_KEY=generate-a-long-random-string
SESSION_MAX_AGE=43200
COOKIE_SECURE=false            # set true behind HTTPS in production

# --- storage ---
DATABASE_URL=sqlite:///./spi_dashboard.db   # Postgres URL on Render

# --- demo clock (mock phase only; unset for live) ---
APP_NOW=2026-05-30

# --- per-source live switches (default = mock) ---
# CLINIKO_LIVE=true
# GOOGLE_ADS_LIVE=true
# META_LIVE=true

# --- Cliniko (Phase 3) ---
# CLINIKO_API_KEY=
# CLINIKO_SHARD=au1

# --- Google Ads / YouTube (Phase 4) ---
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_CUSTOMER_ID=

# --- Meta (Phase 5) ---
# META_SYSTEM_USER_TOKEN=
# META_AD_ACCOUNT_ID=

# --- later: GBP / GA4 / GoHighLevel ---
# GBP_LOCATION_IDS=
# GA4_PROPERTY_ID=
# GA4_SERVICE_ACCOUNT_JSON=
# GHL_API_KEY=
